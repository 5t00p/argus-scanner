<?xml version="1.0" encoding="utf-8"?>
<!-- The Argus server uses our own self-signed certificate. For the server's addresses,
     trust ONLY that certificate (imported from the server's keystore), not the usual public CAs. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="@raw/argus_cert" />
        </trust-anchors>
    </domain-config>
</network-security-config>
